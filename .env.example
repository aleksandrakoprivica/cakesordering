# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Backend API Configuration
# Options:
#   - Set to "dev" or "development" for development mode (skips actual Stripe payment)
#   - Set to your backend API URL for production (e.g., https://your-api.com)
#   - For local backend: http://localhost:3000
EXPO_PUBLIC_API_URL=dev
